APP_NAME=SCTECH
# En local Laragon: APP_ENV=development, APP_DEBUG=true, APP_URL=http://sctech-site.test
# En production cPanel: APP_ENV=production, APP_DEBUG=false, APP_URL=https://votre-domaine.ma
APP_ENV=development
APP_DEBUG=true
APP_URL=http://sctech-site.test
APP_KEY=change-with-a-64-character-random-secret
APP_TIMEZONE=UTC
APP_LOCALE=fr

# Chemins d'execution (auto-detectes par defaut si laisses vides) :
# Local : APP_ROOT vide (detecte C:\laragon\www\sctech-site), PUBLIC_PATH vide (detecte C:\laragon\www\sctech-site\public)
# Production cPanel :
# APP_ROOT=/home/<cpanel-user>/sctech-site
# PUBLIC_PATH=/home/<cpanel-user>/public_html
APP_ROOT=
PUBLIC_PATH=

# Base de donnees :
# Local Laragon : DB_HOST=127.0.0.1, DB_NAME=sctech, DB_USER=root (ou sctech)
# Production cPanel Heberjahiz : DB_NAME=<cpanel-user>_sctech, DB_USER=<cpanel-user>_dbuser
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sctech
DB_USER=sctech
DB_PASS=change-me
DB_CHARSET=utf8mb4

SESSION_NAME=sctech_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
TRUSTED_PROXIES=
HSTS_ENABLED=false
CSP_UPGRADE_INSECURE_REQUESTS=false

MAIL_TRANSPORT=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=no-reply@sctech.ma
MAIL_FROM_NAME=SCTECH
MAIL_TO_ADDRESS=contact@sctech.ma
FORM_MAIL_REQUIRED=false

FORM_RATE_15_MIN=5
FORM_RATE_DAY=20
LEAD_RETENTION_DAYS=0
CONSENT_POLICY_VERSION=draft

COMPANY_LEGAL_NAME=
COMPANY_LEGAL_FORM=
COMPANY_ADDRESS=
COMPANY_RC=
COMPANY_ICE=
COMPANY_IF=
COMPANY_PHONE=
COMPANY_LINKEDIN=
COMPANY_PUBLICATION_DIRECTOR=
COMPANY_HOSTING_DETAILS=
PRIVACY_RETENTION_POLICY=
LEGAL_REVIEW_APPROVED=false
PRIVACY_REVIEW_APPROVED=false
COOKIE_REVIEW_APPROVED=false
PRODUCTION_HOSTING_CONFIRMED=false
LOGO_VECTOR_MASTER_RECEIVED=false
LOGO_RIGHTS_APPROVED=false
